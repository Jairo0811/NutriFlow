# PostgreSQL / Docker Compose
POSTGRES_DB=NutriFlowDb
POSTGRES_USER=nutriflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=5000

# Mobile app
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# API / ASP.NET Core
ConnectionStrings__NutriFlow=Host=postgres;Port=5432;Database=NutriFlowDb;Username=nutriflow;Password=change-me
Jwt__SigningKey=replace-with-at-least-32-bytes-of-random-secret-material
Jwt__GoogleClientIds__0=your-google-client-id.apps.googleusercontent.com
Cors__AllowedOrigins__0=https://your-mobile-web-origin.example
ASPNETCORE_ENVIRONMENT=Production
