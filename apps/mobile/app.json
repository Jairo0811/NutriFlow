{
  "expo": {
    "name": "NutriFlow",
    "slug": "nutriflow",
    "scheme": "nutriflow",
    "version": "1.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./icon.png",
    "android": {
      "package": "com.jairomatias.nutriflow"
    },
    "ios": {
      "bundleIdentifier": "com.jairomatias.nutriflow",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07110B",
          "image": "./splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be3c6628-aeca-4fee-8053-946265d60afa"
      }
    },
    "owner": "jairomatias0811"
  }
}
