{
  "expo": {
    "name": "NutriFlow",
    "slug": "nutriflow",
    "scheme": "nutriflow",
    "version": "1.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./icon.png",
    "android": {
      "package": "com.jairomatias.nutriflow"
    },
    "ios": {
      "bundleIdentifier": "com.jairomatias.nutriflow"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07110B",
          "image": "./splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
